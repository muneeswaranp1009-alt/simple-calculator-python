def add(num1,num2):
    return num1 + num2

def sub(num1,num2):
    return num1 - num2

def multiply(num1,num2):
    return num1 * num2

def divide(num1,num2):
    if num2 ==0:
        return "Not divisable by 0"
    return num1 / num2

def menu():
    print("\n ----------Python Mini Calculator--------")
    print("\n")
    print("1.Addition")
    print("2.Subraction")
    print("3.Multiplication")
    print("4.Division")
    print("5.Exit")
    choice =input("Enter the choice:")
    if choice in ("1","2","3","4",'5'):
        if choice == '5':
            print("See you again!, Bye..")
            return
        
        try:
            num1 =float(input("Enter the First Number:"))
            num2 = float(input("Enter the Second Number:"))
        except ValueError:
            print("Please enter a valid number!")
            return
            
        if choice == "1":
            print(f"Answer is {add(num1 , num2)}")
        elif choice == '2':
            print(f"Answer is {sub(num1 , num2)}")
        elif choice == '3':
            print(f"Answer is {multiply(num1 , num2)}")
        elif choice == '4':
            print(f"Answer is {divide(num1 , num2)}")
    else:
        print("Invalid choice!")
if __name__ == '__main__':
    menu()